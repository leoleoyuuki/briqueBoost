/**
 * Core Philosophy: This ruleset implements a strict user-ownership security model.
 * All data is considered private and is only accessible by the user who created it.
 * There is no public or shared data in this model.
 *
 * Data Structure: The entire data model is hierarchical, with all user-specific
 * collections nested under the /users/{userId} path. This structure naturally
 * isolates each user's data, making security rules simple, performant, and easy to audit.
 *
 * Key Security Decisions:
 * - Default Deny: All operations are denied by default. Access is only granted through explicit `allow` statements.
 * - User Data Isolation: Users can only read or write documents within their own data tree (i.e., paths starting with /users/{their_own_uid}).
 * - No User Enumeration: Listing documents from the top-level `/users` collection is explicitly forbidden to prevent attackers from discovering all user profiles.
 *
 * Denormalization for Authorization: The data structure is inherently optimized for
 * authorization. By placing all data under a user-specific path `/users/{userId}`,
 * ownership can be verified simply by checking the path parameter against the
 * authenticated user's ID. This avoids slow and costly `get()` calls to other documents.
 * Additionally, relational IDs (e.g., `userId`) are stored within documents
 * to enforce data integrity during creation and prevent re-parenting during updates.
 *
 * Structural Segregation: The design uses structural segregation by default. All
 * user data is confined to private subcollections, cleanly separating it from any
 * potential future public or admin collections. This ensures that list operations
 * on user data are always securely scoped to the authenticated user.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // Helper Functions
    // ----------------------------------------------------------------------

    /**
     * Checks if a user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user is the owner of the resource
     * based on the userId provided in the document path.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks if the user is the owner AND the document already exists.
     * Used for safe update and delete operations.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * Enforces that a specific field is immutable and cannot be changed during an update.
     */
    function isImmutable(field) {
      return request.resource.data[field] == resource.data[field];
    }

    /**
     * On create, validates that the User document's internal 'id' field
     * matches the document's ID in the path.
     */
    function hasValidUserData(userId) {
      return request.resource.data.id == userId;
    }
    
    /**
     * On create, validates that the Item document's internal 'userId' and 'id' fields
     * match the IDs in the document's path.
     */
    function hasValidItemData(userId, itemId) {
      return request.resource.data.userId == userId && request.resource.data.id == itemId;
    }

    /**
     * On create, validates that the WishlistItem document's internal 'userId' and 'id' fields
     * match the IDs in the document's path.
     */
    function hasValidWishlistItemData(userId, wishlistItemId) {
      return request.resource.data.userId == userId && request.resource.data.id == wishlistItemId;
    }
    
    // ----------------------------------------------------------------------
    // Collection Rules
    // ----------------------------------------------------------------------

    /**
     * @description Manages user profile documents.
     * @path /users/{userId}
     * @allow (create) A new user with UID 'user_abc' creates their own profile at '/users/user_abc'.
     * @allow (get) An authenticated user 'user_abc' reads their own profile.
     * @deny (create) An authenticated user 'user_abc' tries to create a profile at '/users/user_xyz'.
     * @deny (list) Any user, authenticated or not, tries to list all documents in the '/users' collection.
     * @principle Restricts access to a user's own data tree and allows self-creation of a profile.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Security: Prevent user enumeration.
      allow create: if isOwner(userId) && hasValidUserData(userId);
      allow update: if isExistingOwner(userId) && isImmutable('id');
      allow delete: if isExistingOwner(userId);

      /**
       * @description Manages items owned by a user.
       * @path /users/{userId}/items/{itemId}
       * @allow (create) User 'user_abc' creates a new item at '/users/user_abc/items/item_123'.
       * @allow (list) User 'user_abc' lists all of their own items.
       * @deny (get) User 'user_xyz' attempts to read an item from '/users/user_abc/items/item_123'.
       * @deny (update) User 'user_abc' attempts to change the 'userId' of an existing item.
       * @principle Enforces strict data ownership within a user's private subcollection.
       */
      match /items/{itemId} {
        allow get, list, delete: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidItemData(userId, itemId);
        allow update: if isExistingOwner(userId) && isImmutable('id') && isImmutable('userId');
      }

      /**
       * @description Manages a customer wishlist for a user.
       * @path /users/{userId}/wishlistItems/{wishlistItemId}
       * @allow (create) User 'user_abc' creates a new wishlist item.
       * @allow (list) User 'user_abc' lists all of their own wishlist items.
       * @deny (get) User 'user_xyz' attempts to read another user's wishlist.
       * @principle Enforces strict data ownership for private user notes.
       */
      match /wishlistItems/{wishlistItemId} {
        allow get, list, delete: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidWishlistItemData(userId, wishlistItemId);
        allow update: if isExistingOwner(userId) && isImmutable('id') && isImmutable('userId');
      }

      /**
       * @description Manages monthly sales summaries for a user.
       * @path /users/{userId}/monthlySummaries/{summaryId}
       * @allow (get, list) User 'user_abc' can read their own monthly summaries for charts.
       * @allow (create, update) The system can create or update a monthly summary when a sale occurs.
       * @deny (get) User 'user_xyz' attempts to read another user's sales data.
       * @principle Enforces strict data ownership for aggregated financial data.
       */
      match /monthlySummaries/{summaryId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if false;
      }
    }
    
    /**
     * @description Manages activation codes.
     * @path /activationCodes/{codeId}
     * @allow (create) The admin user can create new codes.
     * @allow (get, list) The admin user can read all codes.
     * @allow (update) An authenticated user can redeem an unused code for themselves.
     * @deny (delete) No one can delete codes.
     */
    match /activationCodes/{codeId} {
      function isAdmin() {
        return request.auth.uid == 'nccUQWtsTsRmnFXPn3HnMZ4R9ch1';
      }

      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isAdmin() && request.resource.data.id == codeId;
      
      // Allow a user to claim an unused code
      allow update: if isSignedIn()
                    && resource.data.isUsed == false
                    && request.resource.data.isUsed == true
                    // Ensure they are claiming it for themselves
                    && request.resource.data.usedBy == request.auth.uid
                    // Ensure no other fields are being changed except the 'used' ones
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isUsed', 'usedBy', 'usedAt']);

      allow delete: if isAdmin();
    }
  }
}
